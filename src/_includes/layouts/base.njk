<!doctype html>
<html lang="{{ site.idioma }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {{ site.nombre }}{% else %}{{ site.nombre }}{% endif %}</title>
  <meta name="description" content="{{ metaDescripcion or site.descripcion }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{% if layout == 'layouts/articulo.njk' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title or site.nombre }}">
  <meta property="og:description" content="{{ metaDescripcion or site.descripcion }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.nombre }}">
  <meta property="og:locale" content="es_ES">
  {% if imagen %}<meta property="og:image" content="{{ site.url }}{{ imagen }}">
  <meta name="twitter:card" content="summary_large_image">{% endif %}
  {% if site.googleVerificacion %}<meta name="google-site-verification" content="{{ site.googleVerificacion }}">{% endif %}
  {% if layout == 'layouts/articulo.njk' %}
  {# Datos estructurados (schema.org) para que Google entienda que es un articulo y su fecha. #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ title | dump | safe }},
    "description": {{ (metaDescripcion or site.descripcion) | dump | safe }},
    {% if imagen %}"image": "{{ site.url }}{{ imagen }}",{% endif %}
    {% if fechaPublicacion %}"datePublished": "{{ fechaPublicacion | fechaIso }}",
    "dateModified": "{{ (fechaActualizacion or fechaPublicacion) | fechaIso }}",{% endif %}
    "inLanguage": "es-ES",
    "mainEntityOfPage": "{{ site.url }}{{ page.url }}",
    "author": { "@type": "Organization", "name": {{ site.nombre | dump | safe }}, "url": "{{ site.url }}/" },
    "publisher": { "@type": "Organization", "name": {{ site.nombre | dump | safe }}, "url": "{{ site.url }}/" }
  }
  </script>
  {% endif %}
  <link rel="stylesheet" href="/assets/css/style.css">

  {# TODO (dueño/estratega): cuando se dé de alta AdSense, pegar aquí el script de
     verificación del sitio y, tras la aprobación, el script de anuncios. No se incluye
     por defecto para no declarar un ID de AdSense que todavía no existe. #}
</head>
<body>
  <header class="sitio-cabecera">
    <a class="sitio-marca" href="/">{{ site.nombre }}</a>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="sitio-pie">
    <p class="disclosure">{{ site.disclosureAmazon }}</p>
    <p>&copy; {% anio %} {{ site.nombre }} · <a href="/privacidad/">Aviso legal y privacidad</a></p>
  </footer>
</body>
</html>
